{
  "name": "@webloom/api",
  "version": "1.0.0",
  "description": "Webloom Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node test_providers.js",
    "test:quality": "node test_quality_boundary.js",
    "test:phases": "node test_phase_p12_identity.js && node test_phase_p13_canonical_profile.js && node test_phase_p14_api_boundary.js && node test_phase_p15_consumer_migration.js && node test_phase_p18_source_grounded_fallback.js && node test_phase_p19_google_reputation.js",
    "benchmark": "node benchmarks/benchmark.test.js",
    "review": "node review-cli.js",
    "build": "echo 'No build step for API'",
    "test:ai": "node test_ai_providers.js && node test_ai_provenance.js && node test_ai_datasets.js && node test_ai_foundation.js && node test_ai_eval.js && node test_ai_finetune.js",
    "benchmark:ai": "node eval/run.js --backend echo && node eval/run.js --backend fallback",
    "ai:benchmark:baseline": "node eval/run.js --backend baseline",
    "ai:benchmark:live": "node eval/run.js --backend live",
    "ai:dataset:validate": "node eval/dataset_validate.js",
    "ai:dataset:report": "node eval/dataset_report.js",
    "ai:dataset:build": "node eval/dataset_build.js",
    "ai:corrections:baseline": "node eval/record_baseline_corrections.js",
    "ai:dataset:format": "node ../../finetune/scripts/format_dataset.mjs",
    "ai:finetune:validate": "node ../../finetune/scripts/protect_holdout.mjs && node ../../finetune/scripts/format_dataset.mjs",
    "ai:finetune": "bash ../../finetune/scripts/train_runner.sh",
    "ai:finetune:evaluate": "bash ../../finetune/scripts/select_runner.sh",
    "ai:finetune:register": "node ../../finetune/scripts/register_candidate.mjs",
    "ai:serve": "bash ../../finetune/scripts/serve_runner.sh",
    "ai:model:load": "node ../../finetune/scripts/model_load_check.mjs"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "libphonenumber-js": "^1.13.12"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.0.2"
  }
}
