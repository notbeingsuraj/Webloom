# Server Configuration
PORT=5001
NODE_ENV=development

# ============================
# WEBLOOM AI
# ============================
# Three independent providers, tried in order. The next provider is only
# contacted after the previous one actually fails. There is no gateway.

AI_PRIMARY_PROVIDER=openrouter
AI_SECONDARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=local

# Hard ceiling on any single AI request. Brand DNA / digital audit are
# long-running, so this is separate from EXTRACTION_TIMEOUT_MS — but it is
# still a hard timeout. Nothing may hang indefinitely.
AI_TIMEOUT_MS=30000
# Retries per provider, and only for retryable failures (timeout / 429 / 5xx /
# connection). 1 => at most 2 attempts per provider.
AI_MAX_RETRIES=1
# Ceiling for ONE generate() call across all providers and all retries, so a
# slow chain can never hold a user request open for minutes. Each attempt is
# clamped to whatever is left of this budget.
AI_MAX_TOTAL_MS=90000
# How many times one provider may re-dispatch at a smaller max_tokens after a
# credit pre-flight rejection (HTTP 402). OpenRouter answers those with the
# exact ceiling you can afford, e.g. "you requested up to 6000 tokens, but can
# only afford 1200", and it bills tokens actually generated — so shrinking the
# request is free and lets smaller operations survive a nearly-empty balance.
# 1 is enough; a second clamp on the same shrinking balance changes nothing.
AI_MAX_TOKEN_DOWNGRADES=1
# Completion ceiling the /health probes ask for. Do NOT lower this to 1 hoping
# to "save tokens": providers bill generated tokens, not the ceiling, so the
# probe costs the same either way — but a 1-token probe passes on an account
# with no credit left, and /health/ai then reports "ok" while every real
# request fails with HTTP 402. Keep it at or above your heaviest operation
# (brand DNA asks for 6000) so `usable: true` means "this provider can serve
# our heaviest operation".
AI_PROBE_MAX_TOKENS=6000
# At boot, verify each provider's key and model with one real request.
# Set to false to skip (e.g. in CI).
# AI_PROBE_VERIFY_AUTH=true

# ============================
# OPENROUTER  (primary)
# ============================
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model id from https://openrouter.ai/models, e.g.
#   anthropic/claude-sonnet-4.5, openai/gpt-4o-mini, google/gemini-2.5-flash
OPENROUTER_MODEL=
# Optional per-provider timeout override (defaults to AI_TIMEOUT_MS)
# OPENROUTER_TIMEOUT_MS=
# Optional: route expensive operations to a stronger model. Unset = use
# OPENROUTER_MODEL for everything.
# OPENROUTER_BRAND_MODEL=
# OPENROUTER_AUDIT_MODEL=
# OPENROUTER_EXTRACTION_MODEL=
# Attribution headers OpenRouter asks for on free/router models.
# OPENROUTER_APP_URL=https://webloom.dev
# OPENROUTER_APP_NAME=Webloom

# ============================
# GEMINI  (secondary fallback)
# ============================
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# e.g. gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_TIMEOUT_MS=
# GEMINI_BRAND_MODEL=
# GEMINI_AUDIT_MODEL=
# GEMINI_EXTRACTION_MODEL=

# ============================
# LOCAL AI  (final fallback, optional)
# ============================
# Any OpenAI-compatible server: Ollama, LM Studio, vLLM, llama.cpp, LiteLLM.
# Not a hard dependency — if this is absent or down, Webloom still runs on the
# providers above.
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=
# Most local servers run keyless; set true only if yours requires a key.
# LOCAL_AI_REQUIRES_API_KEY=false
# LOCAL_AI_TIMEOUT_MS=

# Legacy single-model overrides. Leave unset unless you need every operation
# on one specific model regardless of provider.
# AI_PRIMARY_MODEL=
# AI_FALLBACK_MODEL=

# AI enrichment behaviour (see src/config/env.js)
# Replace a populated value only when its confidence is below this floor.
# 0 restores strict gap-fill-only behaviour.
AI_ENRICHMENT_OVERWRITE_BELOW=0.5
# An AI value must clear this bar to replace anything. Identity fields
# (name/phone/website/address/coordinates) additionally require 0.8.
AI_ENRICHMENT_MIN_CONFIDENCE=0.75
# Crawl the business's own website to fill contact/location gaps, proposing
# candidate domains via AI when no website is known. false disables both.
AI_OFFICIAL_WEBSITE=true
# Min name similarity for a crawled page to be accepted as this business.
AI_OFFICIAL_WEBSITE_NAME_MATCH=0.75
# How many AI-proposed domains to probe when no website is known.
AI_OFFICIAL_WEBSITE_MAX_CANDIDATES=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL=http://localhost:5173

# Geoapify Places API (backend only — never place the real key here, never expose to frontend)
GEOAPIFY_API_KEY=

# SQLite Database (for persistent business identity)
# Leave empty for default: ./webloom.db in apps/api directory
SQLITE_DATABASE_PATH=

# Debug
DEBUG_BUSINESS_ANALYSIS=false

# Extraction Configuration
EXTRACTION_TIMEOUT_MS=15000
EXTRACTION_MAX_RETRIES=2
