# Server Configuration
PORT=5001
NODE_ENV=development

# AI Configuration (OpenCode gateway — OpenAI-compatible)
# Create/OpenCode API key at https://opencode.ai/auth and paste it in apps/api/.env (gitignored).
# Never commit a real key here.
OPENCODE_API_KEY=
# OpenCode Gateway (Zen = pay-as-you-go). Subscription? use https://opencode.ai/zen/go/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# OpenCode model IDs (bare catalog names — the OpenCode gateway has no auto/* aliases)
# IMPORTANT: this client only speaks POST {base}/chat/completions. Zen serves some
# models on provider-native routes instead (/zen/v1/messages for Anthropic models,
# /zen/v1/responses for OpenAI models, /zen/v1/models/{id} for Google models). If the
# server boots with "model ... is not routable on /chat/completions", switch that role
# to a model Zen serves on the OpenAI-compatible route — see https://opencode.ai/docs/zen
OPENCODE_FAST_MODEL=gemini-3.8-flash
OPENCODE_REASONING_MODEL=claude-sonnet-5
OPENCODE_CODING_MODEL=claude-sonnet-5
OPENCODE_COPYWRITING_MODEL=gemini-3.8-flash
OPENCODE_VISION_MODEL=gemini-3.8-flash
# Optional: fallback used when the primary errors or times out.
AI_FALLBACK_MODEL=gemini-3.8-flash
# Optional: force every task onto one model, overriding the per-role spread.
# AI_PRIMARY_MODEL=claude-sonnet-5
# Optional: AI generation budget in ms (default 90000). Kept separate from the
# extraction timeout because enrichment/audit calls are long-running.
# AI_TIMEOUT_MS=90000
# At boot, verify the key authenticates and the model is routable with one
# max_tokens:1 request. The catalog endpoint is served WITHOUT auth, so without
# this check a wrong key reports "reachable" while every AI call 401s. Costs one
# token per boot; set to false to skip.
# AI_PROBE_VERIFY_AUTH=false

# AI enrichment behaviour (see src/config/env.js)
# Replace a populated value only when its confidence is below this floor.
# 0 restores strict gap-fill-only behaviour.
AI_ENRICHMENT_OVERWRITE_BELOW=0.5
# An AI value must clear this bar to replace anything. Identity fields
# (name/phone/website/address/coordinates) additionally require 0.8.
AI_ENRICHMENT_MIN_CONFIDENCE=0.75
# Crawl the business's own website to fill contact/location gaps, proposing
# candidate domains via AI when no website is known. false disables both.
AI_OFFICIAL_WEBSITE=true
# Min name similarity for a crawled page to be accepted as this business.
AI_OFFICIAL_WEBSITE_NAME_MATCH=0.75
# How many AI-proposed domains to probe when no website is known.
AI_OFFICIAL_WEBSITE_MAX_CANDIDATES=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL=http://localhost:5173

# Geoapify Places API (backend only — never place the real key here, never expose to frontend)
GEOAPIFY_API_KEY=

# SQLite Database (for persistent business identity)
# Leave empty for default: ./webloom.db in apps/api directory
SQLITE_DATABASE_PATH=

# Debug
DEBUG_BUSINESS_ANALYSIS=false

# Extraction Configuration
EXTRACTION_TIMEOUT_MS=15000
EXTRACTION_MAX_RETRIES=2
