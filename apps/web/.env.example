# API base URL used by the web client. Proxied to http://localhost:5001 in dev.
VITE_API_URL=http://localhost:5001/api

# --- Site / SEO ---
# Canonical production URL (used for sitemap.xml, canonical + OG URLs, robots.txt).
# Defaults to http://localhost:5173 in development when unset.
# VITE_PUBLIC_SITE_URL=https://webloom.app

# --- Analytics (Plausible-compatible) ---
# Both must be set for analytics to load; in production builds only.
# Never hardcode secrets — these are public script + domain identifiers.
# VITE_PUBLIC_ANALYTICS_DOMAIN=webloom.app
# VITE_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
# Set to 'true' to require explicit cookie consent before loading analytics.
# VITE_PUBLIC_ANALYTICS_CONSENT_REQUIRED=true

# --- Contact ---
# Public contact email shown on the contact page and legal pages.
# VITE_PUBLIC_CONTACT_EMAIL=hello@webloom.app
